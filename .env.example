# Ben chooses the language-model provider. Nothing here picks one for you.
# Run live evals with: npm run eval -- --provider openai
# or:                  npm run eval -- --provider gemini
# Mock, no keys:       npm run eval -- --mock

LLM_PROVIDER=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Prototype server (prototype/server.ts). With no keys it echoes the mic and speaks with macOS say.
ELEVENLABS_API_KEY=
WANDS={"04E28F4A1F1D90":"Lily"}
MODE=
OPENAI_REALTIME_MODEL=gpt-realtime
